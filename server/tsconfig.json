{
	"extends": "@tsconfig/node22/tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2022"],
		"module": "Preserve",
		"moduleResolution": "Bundler"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
